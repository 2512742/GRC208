    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
