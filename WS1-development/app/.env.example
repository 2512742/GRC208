# Copy to `.env` (same folder) and fill in. `.env` is git-ignored: never commit it.
# Real environment variables override values in this file.

# Required: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Keep false except while developing locally.
DEBUG=false

# Live database: leave DATABASE_URL unset to use the in-project SQLite file
# backend/data/risktrack.sqlite3 (local development, graders, and the VPS, where SQLite is live).
# Only for the Vercel fallback: Neon's *pooled* string as DATABASE_URL and the *direct* one
# as DATABASE_URL_DIRECT (for migrations).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Remote backup: Neon's *direct* string for neondb. `python -m app.cli backup-to-postgres`
# replaces it with a full copy of the live database (the VPS does this daily), and
# `restore-from-backup --into <new file>` rebuilds a SQLite file from it.
# Tests never use it: they use a temporary SQLite file, a local PostgreSQL container, or with
# `TEST_DB=neon pytest` the separate Neon database `risktrack_test` on the same server.
# BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The Alajo's official time zone: deadlines and expiry are evaluated in it (PLAN.md §2.7).
ORG_TIMEZONE=Africa/Lagos

# Optional, local runs only: also write logs to this file.
# LOG_FILE=logs/risktrack.log
