# Copy to `.env` (same folder) and fill in. `.env` is git-ignored: never commit it.
# Real environment variables override values in this file.

# Required: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Keep false except while developing locally.
DEBUG=false

# Database: choose ONE by commenting/uncommenting the two lines below.
#  - Both commented out -> in-project SQLite file backend/data/risktrack.sqlite3
#    (local development, graders, or a VPS deployment).
#  - Both set -> Neon PostgreSQL: the *pooled* string (host contains "-pooler") as DATABASE_URL,
#    the *direct* one (same host without "-pooler") as DATABASE_URL_DIRECT for migrations.
# Tests never use these: they use a temporary SQLite file, or with `TEST_DB=neon pytest` the
# separate Neon database `risktrack_test` on the same server.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The Alajo's official time zone: deadlines and expiry are evaluated in it (PLAN.md §2.7).
ORG_TIMEZONE=Africa/Lagos

# Optional, local runs only: also write logs to this file.
# LOG_FILE=logs/risktrack.log
