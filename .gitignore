# Repository-wide ignores. The app keeps its own rules in WS1-development/app/.gitignore.

# ── Secrets and private links: never commit ──
notes.txt
.env
.env.*
!.env.example
*.pem
*.key
**/app-access-message.txt

# ── Institutional originals (ICDFA brief and template): kept locally, not ours to publish ──
docs/reference/

# ── Office and OS temporary files ──
~$*
*.tmp
.~lock.*#
.DS_Store
Thumbs.db

# ── Archives and editor folders ──
*.zip
.vscode/
.idea/
.claude/
